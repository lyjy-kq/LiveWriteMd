{
    "name": "livewrite-md",
    "displayName": "LiveWriteMD",
    "description": "WYSIWYG Markdown editor for VS Code with Obsidian-style live preview. Tables, Mermaid diagrams, KaTeX math, code block syntax highlighting, and full IME support.",
    "version": "0.0.19",
    "publisher": "lyjy",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/lyjy-kq/livewrite-md-forvscode"
    },
    "bugs": {
        "url": "https://github.com/lyjy-kq/livewrite-md-forvscode/issues"
    },
    "homepage": "https://github.com/lyjy-kq/livewrite-md-forvscode#readme",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "markdown",
        "markdown editor",
        "wysiwyg",
        "obsidian",
        "live preview",
        "mermaid",
        "katex",
        "table",
        "code block",
        "math"
    ],
    "galleryBanner": {
        "color": "#272b33",
        "theme": "dark"
    },
    "markdown": "github",
    "qna": "marketplace",
    "main": "./dist/extension.js",
    "contributes": {
        "configurationDefaults": {
            "workbench.editorAssociations": {
                "{git,gist}:/**/*.md": "default"
            }
        },
        "customEditors": [
            {
                "viewType": "liveWriteMd.editor",
                "displayName": "LiveWriteMD Editor",
                "selector": [
                    {
                        "filenamePattern": "*.md"
                    },
                    {
                        "filenamePattern": "*.md"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "liveWriteMd.openWith",
                "title": "Open with LiveWriteMD",
                "category": "LiveWriteMD"
            },
            {
                "command": "liveWriteMd.enterViewerMode",
                "title": "切换到查看模式",
                "category": "LiveWriteMD",
                "icon": "$(book)"
            },
            {
                "command": "liveWriteMd.enterSourceMode",
                "title": "切换到源码模式",
                "category": "LiveWriteMD",
                "icon": "$(code)"
            },
            {
                "command": "liveWriteMd.enterLiveMode",
                "title": "切换到实时预览",
                "category": "LiveWriteMD",
                "icon": "$(edit)"
            },
            {
                "command": "liveWriteMd.enterMindmapMode",
                "title": "切换到思维导图",
                "category": "LiveWriteMD",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "liveWriteMd.cycleEditorMode",
                "title": "切换编辑模式",
                "category": "LiveWriteMD",
                "icon": "$(sync)"
            },
            {
                "command": "liveWriteMd.toggleMindmapMode",
                "title": "切换思维导图",
                "category": "LiveWriteMD",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "liveWriteMd.cycleTextMode",
                "title": "切换文本模式（实时/阅读/源码）",
                "category": "LiveWriteMD",
                "icon": "$(arrow-swap)"
            },
            {
                "command": "liveWriteMd.openMindmapPanel",
                "title": "在侧边打开思维导图",
                "category": "LiveWriteMD",
                "icon": "$(split-horizontal)"
            },
            {
                "command": "liveWriteMd.exportAsHtml",
                "title": "Export as HTML",
                "category": "LiveWriteMD"
            },
            {
                "command": "liveWriteMd.exportAsPdf",
                "title": "Export as PDF",
                "category": "LiveWriteMD"
            },
            {
                "command": "liveWriteMd.toggleOutline",
                "title": "LiveWriteMD: 显示/隐藏大纲",
                "category": "LiveWriteMD",
                "icon": "$(list-unordered)"
            },
            {
                "command": "liveWriteMd.openSettings",
                "title": "设置",
                "category": "LiveWriteMD",
                "icon": "$(settings-gear)"
            },
            {
                "command": "liveWriteMd.showMemoryUsage",
                "title": "显示内存占用",
                "category": "LiveWriteMD",
                "icon": "$(pulse)"
            },
            {
                "command": "liveWriteMd.insertImage",
                "title": "Insert Image",
                "category": "LiveWriteMD",
                "icon": "$(file-media)"
            },
            {
                "command": "liveWriteMd.insertImageFromExplorer",
                "title": "Insert into LiveWriteMD",
                "category": "LiveWriteMD",
                "icon": "$(file-media)"
            }
        ],
        "keybindings": [
            {
                "command": "liveWriteMd.noop",
                "key": "ctrl+z",
                "mac": "cmd+z",
                "when": "activeCustomEditorId == liveWriteMd.editor"
            },
            {
                "command": "liveWriteMd.noop",
                "key": "ctrl+shift+z",
                "mac": "cmd+shift+z",
                "when": "activeCustomEditorId == liveWriteMd.editor"
            },
            {
                "command": "liveWriteMd.noop",
                "key": "ctrl+y",
                "mac": "cmd+y",
                "when": "activeCustomEditorId == liveWriteMd.editor"
            },
            {
                "command": "liveWriteMd.insertImage",
                "key": "ctrl+shift+i",
                "mac": "cmd+shift+i",
                "when": "activeCustomEditorId == liveWriteMd.editor"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "liveWriteMd.openWith",
                    "when": "resourceExtname == .md",
                    "group": "navigation"
                },
                {
                    "command": "liveWriteMd.insertImageFromExplorer",
                    "when": "activeCustomEditorId == liveWriteMd.editor && resourceExtname =~ /^\\.(png|jpg|jpeg|gif|webp|svg|bmp)$/i",
                    "group": "navigation@2"
                },
                {
                    "command": "liveWriteMd.exportAsHtml",
                    "when": "resourceExtname == .md",
                    "group": "1_modification"
                },
                {
                    "command": "liveWriteMd.exportAsPdf",
                    "when": "resourceExtname == .md",
                    "group": "1_modification"
                }
            ],
            "editor/title": [
                {
                    "command": "liveWriteMd.toggleMindmapMode",
                    "when": "activeCustomEditorId == liveWriteMd.editor",
                    "group": "navigation@5"
                },
                {
                    "command": "liveWriteMd.cycleTextMode",
                    "when": "activeCustomEditorId == liveWriteMd.editor && liveWriteMd.editorMode != mindmap",
                    "group": "navigation@6"
                },
                {
                    "command": "liveWriteMd.openMindmapPanel",
                    "when": "activeCustomEditorId == liveWriteMd.editor",
                    "group": "1_run@1"
                },
                {
                    "command": "liveWriteMd.toggleOutline",
                    "when": "activeCustomEditorId == liveWriteMd.editor",
                    "group": "navigation@9"
                },
                {
                    "command": "liveWriteMd.openSettings",
                    "when": "activeCustomEditorId == liveWriteMd.editor",
                    "group": "navigation@10"
                }
            ]
        },
        "configuration": {
            "title": "LiveWriteMD",
            "properties": {
                "liveWriteMd.largeFileWarningThreshold": {
                    "type": "number",
                    "default": 1048576,
                    "minimum": 0,
                    "description": "Large file warning threshold in bytes. Set to 0 to disable."
                },
                "liveWriteMd.syncDebounceMs": {
                    "type": "number",
                    "default": 300,
                    "minimum": 50,
                    "maximum": 2000,
                    "description": "Sync debounce time in milliseconds"
                },
                "liveWriteMd.enableDebugLog": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable verbose debug logging. Logs appear in the Output panel (View > Output > LiveWriteMD)."
                },
                "liveWriteMd.lineNumbers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show line numbers"
                },
                "liveWriteMd.lineGutterGap": {
                    "type": "number",
                    "default": 4,
                    "minimum": 0,
                    "maximum": 24,
                    "description": "Distance in pixels between the left edge of body text and the line-number rule. Minimum is 0.",
                    "markdownDescription": "正文行最左缘与行号竖线之间的距离（px），最低可调到 `0`。"
                },
                "liveWriteMd.wordWrap": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable word wrap for long lines"
                },
                "liveWriteMd.readableLineLength": {
                    "type": "number",
                    "default": 900,
                    "minimum": 0,
                    "description": "Max content width in pixels. Set to 0 for unlimited. Default: 900"
                },
                "liveWriteMd.lineHeightScale": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "maximum": 3,
                    "description": "Line height multiplier on top of the base line height (Word-style). 1.0 = single spacing.",
                    "markdownDescription": "Word 式倍行距：在基础行高（VS Code 的 `editor.lineHeight`，未设置时为 1.7 倍字号）上乘以该倍数，`1.0` 为单倍行距。"
                },
                "liveWriteMd.fontScale": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0.5,
                    "maximum": 2,
                    "description": "Editor body font size scale. Ctrl+wheel changes this value and saves it automatically.",
                    "markdownDescription": "编辑器正文的字体大小缩放倍率。按 `Ctrl+滚轮` 调整后会自动保存。"
                },
                "liveWriteMd.fontFamilyEnglish": {
                    "type": "string",
                    "default": "",
                    "description": "Font family used for Latin letters and digits. Empty = follow the VS Code editor font. Accepts any installed font family; the in-app panel lists fonts installed on this machine.",
                    "markdownDescription": "英文、数字使用的字体。留空跟随 VS Code 编辑器字体。可填写任意已安装字体；应用内设置面板会列出本机字体供选择。"
                },
                "liveWriteMd.fontFamilyChinese": {
                    "type": "string",
                    "default": "",
                    "description": "Font family used for Chinese characters. Empty = follow the system default. Accepts any installed font family; the in-app panel lists fonts installed on this machine.",
                    "markdownDescription": "中文汉字使用的字体。留空跟随系统默认；英文字体没有 CJK 字形时汉字回退到它。可填写任意已安装字体；应用内设置面板会列出本机字体供选择。"
                },
                "liveWriteMd.theme": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "dark",
                        "light"
                    ],
                    "default": "auto",
                    "description": "Theme setting (auto: follow VS Code theme)"
                },
                "liveWriteMd.imageSaveFolder": {
                    "type": "string",
                    "default": "assets",
                    "description": "Folder name for saved images (relative to .md file). Default: assets"
                },
                "liveWriteMd.pdfBrowserPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Edge/Chrome executable used for PDF export. Leave empty to auto-detect.",
                    "markdownDescription": "导出 PDF 所用的 Edge/Chrome 可执行文件路径。留空则自动探测。"
                },
                "liveWriteMd.defaultMode": {
                    "type": "string",
                    "enum": [
                        "live",
                        "source",
                        "viewer",
                        "mindmap"
                    ],
                    "default": "live",
                    "description": "Default editing mode when opening files",
                    "enumDescriptions": [
                        "Live Preview - Edit with real-time rendering",
                        "Source - Raw Markdown source only",
                        "Viewer - Read-only rendered view",
                        "Mind Map - Canvas outline rendered by the built-in engine"
                    ]
                },
                "liveWriteMd.modeSwitcher": {
                    "type": "string",
                    "enum": [
                        "cycle",
                        "buttons"
                    ],
                    "default": "cycle",
                    "description": "Mode switcher button style in the editor title bar",
                    "enumDescriptions": [
                        "Cycle - Single button that cycles Live → Viewer → Source → Mind Map",
                        "Buttons - Show direct-jump buttons for the other three modes"
                    ]
                },
                "liveWriteMd.rememberLastMode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Remember the editing mode used per file instead of always using Default mode."
                },
                "liveWriteMd.smartUrlPaste": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically wrap a pasted bare URL as a Markdown link."
                },
                "liveWriteMd.mindmapTheme": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "default",
                        "dark"
                    ],
                    "default": "auto",
                    "description": "Mind map color theme. Auto follows the VS Code light/dark theme.",
                    "enumDescriptions": [
                        "Auto - Follow the editor light/dark theme",
                        "Default - Classic light theme",
                        "Dark - Always use the bundled dark theme"
                    ]
                },
                "liveWriteMd.mindmapDefaultExpandLevel": {
                    "type": "number",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 6,
                    "multipleOf": 1,
                    "description": "Default expand level when opening a mind map. 0 shows only the root."
                },
                "liveWriteMd.mindmapNodeMaxWidth": {
                    "type": "number",
                    "default": 20,
                    "minimum": 5,
                    "maximum": 60,
                    "markdownDescription": "思维导图文本节点一行最多排几列（1 列 = 1 个中文字宽），超出换行。"
                },
                "liveWriteMd.mindmapNodeMaxLines": {
                    "type": "number",
                    "default": 3,
                    "minimum": 1,
                    "maximum": 10,
                    "markdownDescription": "思维导图文本节点最多显示几行，超出截断加省略号；点击已选中节点可先展开，再点进入编辑。"
                },
                "liveWriteMd.mindmapPerformanceMode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Only render nodes inside the visible canvas area for better performance on large documents."
                },
                "liveWriteMd.mindmapDisplayCache": {
                    "type": "boolean",
                    "default": false,
                    "description": "开启后，离屏节点最多保留 64 个真实渲染实例，超出时把最早创建的降级为纯文本占位；关闭（默认）时不淘汰，离屏实例一直保留。"
                },
                "liveWriteMd.mindmapInternalLinks": {
                    "type": "boolean",
                    "default": true,
                    "description": "在思维导图中把文档内链接（[[#标题]] / [文字](#标题)）绘制为底层虚线箭头，点击箭头跳转到目标标题。"
                },
                "liveWriteMd.mindmapPerfHud": {
                    "type": "boolean",
                    "default": false,
                    "description": "在思维导图右上角显示性能监控浮层：帧率 / 缓存实例数 / 堆内存 / 换真队列与速率 / 强制布局速率，并记录帧率跳变现场供排查。"
                },
                "liveWriteMd.mindmapLiteEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "启用思维导图降级渲染：缩放低于阈值时省掉行内格式、代码高亮、表格 / 公式 / mermaid 图。"
                },
                "liveWriteMd.mindmapLiteZoom": {
                    "type": "number",
                    "default": 70,
                    "minimum": 10,
                    "maximum": 100,
                    "multipleOf": 5,
                    "markdownDescription": "思维导图缩放到该比例（%）以下时降级渲染：不渲染行内格式、代码高亮、表格 / 公式 / mermaid 图，只保留 Markdown 源码排版。仅在开启「启用降级渲染」后生效。"
                },
                "liveWriteMd.mindmapPlainEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "启用思维导图纯文本缩放：缩放低于阈值时节点只用纯文本占位，不创建 CodeMirror 实例。"
                },
                "liveWriteMd.mindmapPlainZoom": {
                    "type": "number",
                    "default": 40,
                    "minimum": 5,
                    "maximum": 100,
                    "multipleOf": 5,
                    "markdownDescription": "思维导图缩放到该比例（%）以下时只用纯文本占位，不创建 CodeMirror 实例。仅在开启「启用纯文本缩放」后生效；建议不高于降级渲染缩放。"
                },
                "liveWriteMd.highlightActiveLine": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight the line that contains the cursor."
                },
                "liveWriteMd.highlightWhitespace": {
                    "type": "boolean",
                    "default": false,
                    "description": "Render spaces and tabs with subtle markers."
                },
                "liveWriteMd.h1Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 1 color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.h2Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 2 color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.h3Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 3 color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.h4Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 4 color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.h5Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 5 color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.h6Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 6 color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.h1Size": {
                    "type": "number",
                    "default": 1.2,
                    "minimum": 0.9,
                    "maximum": 2,
                    "multipleOf": 0.01,
                    "description": "Heading 1 font size relative to body text."
                },
                "liveWriteMd.boldColor": {
                    "type": "string",
                    "default": "",
                    "description": "Bold text color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.italicColor": {
                    "type": "string",
                    "default": "",
                    "description": "Italic text color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.italicSlant": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use a real slanted italic glyph instead of color-only emphasis."
                },
                "liveWriteMd.boldWeight": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use a real bold font weight for bold text. Off (default): color-only emphasis, weight follows body text.",
                    "markdownDescription": "开启后加粗使用粗体字形；关闭（默认）时加粗只用颜色区分，字重与正文一致。"
                },
                "liveWriteMd.strikethroughColor": {
                    "type": "string",
                    "default": "",
                    "description": "Strikethrough color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.inlineCodeColor": {
                    "type": "string",
                    "default": "",
                    "description": "Inline code text color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.inlineCodeBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Inline code background color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.inlineCodeScale": {
                    "type": "number",
                    "default": 0.95,
                    "minimum": 0.8,
                    "maximum": 1.05,
                    "multipleOf": 0.01,
                    "description": "Inline code font size relative to body text."
                },
                "liveWriteMd.codeblockBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Code block background color. Empty = follow VS Code theme."
                },
                "liveWriteMd.codeblockEdge": {
                    "type": "string",
                    "default": "",
                    "description": "Code block edge color. Empty = follow VS Code theme."
                },
                "liveWriteMd.linkColor": {
                    "type": "string",
                    "default": "",
                    "description": "Link color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.quoteBorderColor": {
                    "type": "string",
                    "default": "",
                    "description": "Blockquote left border color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.quoteTextColor": {
                    "type": "string",
                    "default": "",
                    "description": "Blockquote text color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.hrColor": {
                    "type": "string",
                    "default": "",
                    "description": "Horizontal rule color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.tableBorderColor": {
                    "type": "string",
                    "default": "",
                    "description": "Table border color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.tableHeaderBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Table header background color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.tableStripeBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Background for striped (even) table rows. Empty = no stripes."
                },
                "liveWriteMd.tableSelectedBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Selected table cell highlight color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.bulletColor": {
                    "type": "string",
                    "default": "",
                    "description": "List bullet color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.bulletYOffset": {
                    "type": "number",
                    "default": 0,
                    "minimum": -0.3,
                    "maximum": 0.3,
                    "description": "Vertical bullet offset from the line center, in em (negative = up, positive = down)."
                },
                "liveWriteMd.checkboxAccent": {
                    "type": "string",
                    "default": "",
                    "description": "Checkbox accent color. Empty = auto (follow the theme)."
                },
                "liveWriteMd.outlineAutoOpen": {
                    "type": "boolean",
                    "default": false,
                    "description": "Expand the outline automatically when a file opens."
                },
                "liveWriteMd.outlineWidth": {
                    "type": "number",
                    "default": 280,
                    "minimum": 220,
                    "maximum": 480,
                    "multipleOf": 4,
                    "description": "Default outline panel width in pixels."
                },
                "liveWriteMd.outlineGuides": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show indentation guides in the outline."
                },
                "liveWriteMd.mediaWidth": {
                    "type": "number",
                    "default": 75,
                    "minimum": 20,
                    "maximum": 100,
                    "description": "Default media width as a percentage of body width."
                },
                "liveWriteMd.mediaCenter": {
                    "type": "boolean",
                    "default": true,
                    "description": "Center media that occupies its own line."
                },
                "liveWriteMd.dragThreshold": {
                    "type": "number",
                    "default": 4,
                    "minimum": 2,
                    "maximum": 15,
                    "description": "Mouse movement in pixels required to count as a drag-select."
                },
                "liveWriteMd.doubleClickPin": {
                    "type": "boolean",
                    "default": true,
                    "description": "Double-click to pin the source view of a line."
                },
                "defaultMode": {
                    "description": "打开 Markdown 文件时进入的模式。",
                    "type": "string",
                    "default": "live",
                    "enum": [
                        "live",
                        "source",
                        "viewer",
                        "mindmap"
                    ],
                    "enumDescriptions": [
                        "实时预览（边写边渲染）",
                        "源码（只看 Markdown 原文）",
                        "阅读（只读渲染视图）",
                        "思维导图（画布式大纲）"
                    ]
                },
                "modeSwitcher": {
                    "type": "string",
                    "default": "cycle",
                    "enum": [
                        "cycle",
                        "buttons"
                    ],
                    "enumDescriptions": [
                        "循环（单按钮轮流切换）",
                        "按钮（直达另外三种模式）"
                    ]
                },
                "rememberLastMode": {
                    "description": "开启后重新打开同一文件时回到上次使用的模式，而不是统一用「默认打开模式」。",
                    "type": "boolean",
                    "default": true
                },
                "smartUrlPaste": {
                    "description": "粘贴单独的 URL 时自动包裹成 Markdown 链接文字。",
                    "type": "boolean",
                    "default": true
                },
