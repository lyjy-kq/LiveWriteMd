                    "type": "number",
                    "default": 4,
                    "minimum": 2,
                    "maximum": 15,
                    "multipleOf": 1
                },
                "doubleClickPin": {
                    "description": "关闭后双击不再钉住整行的源码显示。",
                    "type": "boolean",
                    "default": true
                },
                "largeFileWarningThreshold": {
                    "description": "单位字节，0 表示关闭警告。 占位提示：1048576",
                    "type": "string",
                    "default": "1048576"
                },
                "pdfBrowserPath": {
