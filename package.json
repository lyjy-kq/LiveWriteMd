{
  "name": "livewrite-md",
  "displayName": "LiveWriteMD",
  "description": "WYSIWYG Markdown editor for VS Code with Obsidian-style live preview. Tables, Mermaid diagrams, KaTeX math, code block syntax highlighting, and full IME support.",
  "version": "0.0.32",
  "publisher": "lyjy",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyjy-kq/LiveWriteMd"
  },
  "bugs": {
    "url": "https://github.com/lyjy-kq/LiveWriteMd/issues"
  },
  "homepage": "https://github.com/lyjy-kq/LiveWriteMd#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown editor",
    "wysiwyg",
    "obsidian",
    "live preview",
    "mermaid",
    "katex",
    "table",
    "code block",
    "math"
  ],
  "galleryBanner": {
    "color": "#272b33",
    "theme": "dark"
  },
  "markdown": "github",
  "qna": "marketplace",
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "{git,gist}:/**/*.md": "default"
      }
    },
    "customEditors": [
      {
        "viewType": "liveWriteMd.editor",
        "displayName": "LiveWriteMD Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "liveWriteMd.openWith",
        "title": "Open with LiveWriteMD",
        "category": "LiveWriteMD"
      },
      {
        "command": "liveWriteMd.enterViewerMode",
        "title": "切换到查看模式",
        "category": "LiveWriteMD",
        "icon": "$(book)"
      },
      {
        "command": "liveWriteMd.enterSourceMode",
        "title": "切换到源码模式",
        "category": "LiveWriteMD",
        "icon": "$(code)"
      },
      {
        "command": "liveWriteMd.enterLiveMode",
        "title": "切换到实时预览",
        "category": "LiveWriteMD",
        "icon": "$(edit)"
      },
      {
        "command": "liveWriteMd.enterMindmapMode",
        "title": "切换到思维导图",
        "category": "LiveWriteMD",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "liveWriteMd.enterSlidesMode",
        "title": "切换到幻灯片",
        "category": "LiveWriteMD",
        "icon": "$(screen-full)"
      },
      {
        "command": "liveWriteMd.toggleSlidesMode",
        "title": "切换幻灯片",
        "category": "LiveWriteMD",
        "icon": "$(screen-full)"
      },
      {
        "command": "liveWriteMd.cycleEditorMode",
        "title": "切换编辑模式",
        "category": "LiveWriteMD",
        "icon": "$(sync)"
      },
      {
        "command": "liveWriteMd.toggleMindmapMode",
        "title": "切换思维导图",
        "category": "LiveWriteMD",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "liveWriteMd.exportAsHtml",
        "title": "Export as HTML",
        "category": "LiveWriteMD"
      },
      {
        "command": "liveWriteMd.exportAsPdf",
        "title": "Export as PDF",
        "category": "LiveWriteMD"
      },
      {
        "command": "liveWriteMd.toggleOutline",
        "title": "显示/隐藏大纲",
        "category": "LiveWriteMD",
        "icon": "$(list-unordered)"
      },
      {
        "command": "liveWriteMd.openSettings",
        "title": "设置",
        "category": "LiveWriteMD",
        "icon": "$(settings-gear)"
      },
      {
        "command": "liveWriteMd.showMemoryUsage",
        "title": "显示内存占用",
        "category": "LiveWriteMD",
        "icon": "$(pulse)"
      },
      {
        "command": "liveWriteMd.insertImage",
        "title": "Insert Image",
        "category": "LiveWriteMD",
        "icon": "$(file-media)"
      },
      {
        "command": "liveWriteMd.insertImageFromExplorer",
        "title": "Insert into LiveWriteMD",
        "category": "LiveWriteMD",
        "icon": "$(file-media)"
      }
    ],
    "keybindings": [
      {
        "command": "liveWriteMd.noop",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == liveWriteMd.editor"
      },
      {
        "command": "liveWriteMd.noop",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == liveWriteMd.editor"
      },
      {
        "command": "liveWriteMd.noop",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "activeCustomEditorId == liveWriteMd.editor"
      },
      {
        "command": "liveWriteMd.insertImage",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "activeCustomEditorId == liveWriteMd.editor"
      }
    ],
    "submenus": [
      {
        "id": "liveWriteMd.modeMenu",
        "label": "模式",
        "icon": "$(layout)"
      }
    ],
    "menus": {
      "liveWriteMd.modeMenu": [
        {
          "command": "liveWriteMd.enterLiveMode",
          "icon": "$(edit)",
          "group": "navigation@1"
        },
        {
          "command": "liveWriteMd.enterViewerMode",
          "icon": "$(book)",
          "group": "navigation@2"
        },
        {
          "command": "liveWriteMd.enterSourceMode",
          "icon": "$(code)",
          "group": "navigation@3"
        },
        {
          "command": "liveWriteMd.enterMindmapMode",
          "icon": "$(type-hierarchy)",
          "group": "navigation@4"
        },
        {
          "command": "liveWriteMd.enterSlidesMode",
          "icon": "$(screen-full)",
          "group": "navigation@5"
        }
      ],
      "explorer/context": [
        {
          "command": "liveWriteMd.openWith",
          "when": "resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "liveWriteMd.insertImageFromExplorer",
          "when": "activeCustomEditorId == liveWriteMd.editor && resourceExtname =~ /^\\.(png|jpg|jpeg|gif|webp|svg|bmp)$/i",
          "group": "navigation@2"
        },
        {
          "command": "liveWriteMd.exportAsHtml",
          "when": "resourceExtname == .md",
          "group": "1_modification"
        },
        {
          "command": "liveWriteMd.exportAsPdf",
          "when": "resourceExtname == .md",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "submenu": "liveWriteMd.modeMenu",
          "when": "activeCustomEditorId == liveWriteMd.editor",
          "group": "navigation@1"
        },
        {
          "command": "liveWriteMd.toggleOutline",
          "when": "activeCustomEditorId == liveWriteMd.editor",
          "group": "navigation@3"
        },
        {
          "command": "liveWriteMd.openSettings",
          "when": "activeCustomEditorId == liveWriteMd.editor",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "LiveWriteMD",
      "properties": {
        "liveWriteMd.defaultMode": {
          "description": "打开 Markdown 文件时进入的模式。",
          "type": "string",
          "default": "live",
          "enum": [
            "live",
            "source",
            "viewer",
            "mindmap",
            "slides"
          ],
          "enumDescriptions": [
            "实时预览（边写边渲染）",
            "源码（只看 Markdown 原文）",
            "阅读（只读渲染视图）",
            "思维导图（画布式大纲）",
            "幻灯片（16:9 自动分页）"
          ]
        },
        "liveWriteMd.rememberLastMode": {
          "description": "开启后重新打开同一文件时回到上次使用的模式，而不是统一用「默认打开模式」。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.smartUrlPaste": {
          "description": "粘贴单独的 URL 时自动包裹成 Markdown 链接文字。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.lineNumbers": {
          "description": "关闭后正文左侧不再显示行号，正文会更贴近编辑区左缘，适合纯写作。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.lineGutterGap": {
          "description": "正文行最左缘与行号竖线之间的间距。关闭行号后，即为正文与编辑器左边缘的距离。",
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 24,
          "multipleOf": 1
        },
        "liveWriteMd.wordWrap": {
          "description": "长行按正文宽度折行，而不是横向滚动。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.readableLineLength": {
          "description": "超过此宽度后正文居中、两侧留白。设为 0 则不限制。",
          "type": "number",
          "default": 900,
          "minimum": 0,
          "maximum": 1600,
          "multipleOf": 10
        },
        "liveWriteMd.lineHeightScale": {
          "description": "Word 式倍行距：在基础行高（VS Code 的 editor.lineHeight，未设置时为 1.7 倍字号）上乘以该倍数。1.0 为单倍行距。",
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 3,
          "multipleOf": 0.05
        },
        "liveWriteMd.fontScale": {
          "description": "也可在编辑器里按 Ctrl/Cmd + 滚轮调整。",
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 1.6,
          "multipleOf": 0.05
        },
        "liveWriteMd.fontFamilyEnglish": {
          "description": "英文、数字使用的字体。列表来自本机已安装字体，可直接输入筛选；留空跟随 VS Code 编辑器字体。 占位提示：输入字体名筛选，或展开列表选择",
          "type": "string",
          "default": ""
        },
        "liveWriteMd.fontFamilyChinese": {
          "description": "中文汉字使用的字体。列表来自本机已安装字体，可直接输入筛选；留空跟随系统默认。 占位提示：输入字体名筛选，或展开列表选择",
          "type": "string",
          "default": ""
        },
        "liveWriteMd.highlightActiveLine": {
          "description": "光标所在行加上淡背景。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.highlightWhitespace": {
          "description": "把空格 / 制表符用淡点标记出来。",
          "type": "boolean",
          "default": false
        },
        "liveWriteMd.h1Color": {
          "description": "一级标题的文字颜色；留空 = 跟随主题默认色，只影响这一级。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.h2Color": {
          "description": "二级标题的文字颜色；留空 = 跟随主题默认色，只影响这一级。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.h3Color": {
          "description": "三级标题的文字颜色；留空 = 跟随主题默认色，只影响这一级。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.h4Color": {
          "description": "四级标题的文字颜色；留空 = 跟随主题默认色，只影响这一级。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.h5Color": {
          "description": "五级标题的文字颜色；留空 = 跟随主题默认色，只影响这一级。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.h6Color": {
          "description": "六级标题的文字颜色；留空 = 跟随主题默认色，只影响这一级。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.h1Size": {
          "description": "相对于正文的字号倍率。",
          "type": "number",
          "default": 1.2,
          "minimum": 0.9,
          "maximum": 2,
          "multipleOf": 0.01
        },
        "liveWriteMd.headingBold": {
          "description": "关闭（默认）时标题与正文同字重，只靠字号和颜色区分层级；开启后一级标题用 700、其余级别用 600。",
          "type": "boolean",
          "default": false
        },
        "liveWriteMd.boldColor": {
          "description": "加粗文字的颜色；留空 = 跟随主题默认，可单独上色让加粗在正文里更醒目。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.boldWeight": {
          "description": "关闭（默认）时加粗只以颜色区分、字重与正文一致；开启后使用粗体字形。",
          "type": "boolean",
          "default": false
        },
        "liveWriteMd.italicColor": {
          "description": "斜体文字的颜色；留空 = 跟随主题默认，可给斜体一个偏柔和的色替代倾斜。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.italicSlant": {
          "description": "关闭（默认）时斜体只以颜色区分、字形不倾斜；开启后使用真斜体字形。",
          "type": "boolean",
          "default": false
        },
        "liveWriteMd.strikethroughColor": {
          "description": "删除线文字的颜色；留空 = 跟随主题默认，调淡可弱化已完成的待办。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.inlineCodeColor": {
          "description": "行内代码（`文字`）的文字色；留空 = 跟随主题，与代码块配色保持一致。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.inlineCodeBackground": {
          "description": "行内代码的背景色；留空 = 跟随主题，加一层淡底能让代码在正文里更好认。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.inlineCodeScale": {
          "description": "相对于正文的字号倍率（默认略小一点）。",
          "type": "number",
          "default": 0.95,
          "minimum": 0.8,
          "maximum": 1.05,
          "multipleOf": 0.01
        },
        "liveWriteMd.codeblockBackground": {
          "description": "留空则跟随 VS Code 主题。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.codeblockEdge": {
          "description": "留空则跟随 VS Code 主题。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.linkColor": {
          "description": "正文链接的颜色；留空 = 跟随主题，改它可让链接更醒目或更低调。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.quoteBorderColor": {
          "description": "引用块左侧竖线的颜色；留空 = 跟随主题，用它拉开引用与正文的层次。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.quoteTextColor": {
          "description": "引用块内文字的颜色；留空 = 跟随主题，通常比正文略淡以区分出处。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.hrColor": {
          "description": "分隔线（---）的颜色；留空 = 跟随主题，想弱化分节时可把它调淡。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.tableBorderColor": {
          "description": "表格边框和网格线的颜色；留空 = 跟随主题，边框太抢眼时可调淡。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.tableHeaderBackground": {
          "description": "表头行的背景色；留空 = 跟随主题，加一层底色可让表头和数据行分开。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.tableStripeBackground": {
          "description": "为偶数数据行加底色；留空（默认）则不显示斑马纹。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.tableSelectedBackground": {
          "description": "编辑时选中单元格的高亮底色；留空 = 跟随主题，选区不显眼时换个明显的颜色。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.bulletColor": {
          "description": "列表圆点和序号标记的颜色；留空 = 跟随主题，想突出层级时可单独上色。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.bulletYOffset": {
          "description": "圆点相对行中心的上下微调：0 为行正中，负值向上、正值向下。",
          "type": "number",
          "default": 0,
          "minimum": -0.3,
          "maximum": 0.3,
          "multipleOf": 0.01
        },
        "liveWriteMd.checkboxAccent": {
          "description": "复选框勾选后的强调色；留空 = 跟随主题，待办很多时上色更易扫读。",
          "type": "string",
          "default": "",
          "pattern": "^$|^#[0-9a-fA-F]{3,8}$|^rgba?\\(|^[a-z]+$",
          "patternErrorMessage": "请输入 CSS 颜色（如 #338122、rgba(...) ），留空表示跟随主题。"
        },
        "liveWriteMd.outlineAutoOpen": {
          "description": "开启后每次打开 Markdown 文件都自动展开大纲面板；关闭则手动点开。",
          "type": "boolean",
          "default": false
        },
        "liveWriteMd.outlineWidth": {
          "description": "大纲面板首次打开时的宽度；之后手动拖拽调过的宽度会单独记住。",
          "type": "number",
          "default": 280,
          "minimum": 220,
          "maximum": 480,
          "multipleOf": 4
        },
        "liveWriteMd.outlineGuides": {
          "description": "开启时大纲条目之间显示缩进引导线，层级更直观；关闭则只靠文字缩进。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.imageSaveFolder": {
          "description": "拖拽 / 粘贴的图片相对当前 Markdown 所在目录存放。 占位提示：assets",
          "type": "string",
          "default": "assets"
        },
        "liveWriteMd.mediaWidth": {
          "description": "图片 / Mermaid 初始占正文宽度的百分比。",
          "type": "number",
          "default": 75,
          "minimum": 20,
          "maximum": 100,
          "multipleOf": 1
        },
        "liveWriteMd.mediaCenter": {
          "description": "开启时独占一行的图片 / Mermaid 图居中显示；关闭则靠左对齐。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.mindmapTheme": {
          "description": "设为自动时跟随编辑器当前的明 / 暗主题。",
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "default",
            "dark"
          ],
          "enumDescriptions": [
            "自动（跟随编辑器）",
            "默认（经典浅色）",
            "深色"
          ]
        },
        "liveWriteMd.mindmapNodeWash": {
          "description": "节点背景色 = 标题色按该比例混入。比例越低，底色越淡、文字与底色的对比越强，笔画看起来更清晰；0 = 完全透明（只剩边框）。",
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 40,
          "multipleOf": 1
        },
        "liveWriteMd.quickCardWidth": {
          "description": "快速卡片的宽度（拖动卡片左边界调整，全局生效）。",
          "type": "number",
          "default": 280,
          "minimum": 160,
          "maximum": 480,
          "multipleOf": 10
        },
        "liveWriteMd.mindmapDefaultExpandLevel": {
          "description": "打开导图时默认展开到第几层，0 = 只显示根节点。",
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "multipleOf": 1
        },
        "liveWriteMd.mindmapNodeMaxWidth": {
          "description": "文本节点一行最多排几列（1 列 = 1 个中文字宽），超出换行；与「节点最大行数」共同决定截断点。",
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 60,
          "multipleOf": 1
        },
        "liveWriteMd.mindmapNodeMaxLines": {
          "description": "文本节点最多显示几行，超出部分截断加省略号；点击已选中的节点可先展开到最大行数，再点进入编辑。",
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "multipleOf": 1
        },
        "liveWriteMd.mindmapCodeWidth": {
          "description": "代码块节点的最大宽度（1 列 = 1 个等宽字符宽）；节点最窄 40 列。长行不换行，超出后在节点内左右滚动。",
          "type": "number",
          "default": 60,
          "minimum": 40,
          "maximum": 100,
          "multipleOf": 1
        },
        "liveWriteMd.mindmapInternalLinks": {
          "description": "文档内链接（[[#标题]] 或 [文字](#标题)）在导图中以底层虚线箭头呈现，从内链所在节点指向目标标题节点，点击箭头跳转。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.mindmapGestureCrisp": {
          "description": "开启（默认）时，拖动和滚轮缩放期间不提升合成层，文字在运动中也按当前比例重新栅格化、保留次像素抗锯齿；关闭后手势期间临时提升合成层换帧率，运动中的文字是缓存位图（略灰）。实测 60~74 个可见节点时两者帧间隔相同。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.quickCardEnabled": {
          "description": "在导图右边界显示快速卡片栏，用来记录临时想法。关闭后整条卡片栏隐藏。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.theme": {
          "description": "设为自动时跟随 VS Code 当前主题。",
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "自动（跟随 VS Code）",
            "深色",
            "浅色"
          ]
        },
        "liveWriteMd.syncDebounceMs": {
          "description": "Webview 与文档同步前的等待毫秒数，打字快时可适当调大。",
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 2000,
          "multipleOf": 50
        },
        "liveWriteMd.dragThreshold": {
          "description": "鼠标移动超过多少像素才视为「拖选」并展开整行。",
          "type": "number",
          "default": 4,
          "minimum": 2,
          "maximum": 15,
          "multipleOf": 1
        },
        "liveWriteMd.doubleClickPin": {
          "description": "关闭后双击不再钉住整行的源码显示。",
          "type": "boolean",
          "default": true
        },
        "liveWriteMd.largeFileWarningThreshold": {
          "description": "单位字节，0 表示关闭警告。 占位提示：1048576",
          "type": "string",
          "default": "1048576"
        },
        "liveWriteMd.pdfBrowserPath": {
          "description": "导出 PDF 所用 Edge/Chrome 可执行文件，留空自动探测。 占位提示：留空自动探测",
          "type": "string",
          "default": ""
        },
        "liveWriteMd.enableDebugLog": {
          "description": "详细日志输出到「输出」面板的 LiveWriteMD 通道。",
          "type": "boolean",
          "default": false
        },
        "liveWriteMd.perfMonitor": {
          "description": "在窗口右上角实时显示当前打开文件的性能数据，实时 / 源码 / 阅读 / 导图 / 幻灯片所有模式通用。极简版只有帧率与堆内存；完整版另含 DOM、文档大小、当前模式专属指标（导图节点、幻灯片页数、文本视口行数）与强制布局速率，并记录帧率跳变和长任务现场（可一键复制成 JSON）。默认关闭。",
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "minimal",
            "full"
          ],
          "enumDescriptions": [
            "关闭",
            "极简（帧率 + 内存）",
            "完整（详细指标）"
          ]
        },
        "liveWriteMd.slidesTheme": {
          "description": "自动跟随 VS Code 明暗：浅色用「纸」、深色用「墨」。也可以固定成纸 / 墨 / 靛。",
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "paper",
            "ink",
            "indigo"
          ],
          "enumDescriptions": [
            "自动（跟随编辑器明暗）",
            "纸（暖白 + 朱红）",
            "墨（深色 + 冷蓝）",
            "靛（浅靛 + 青绿）"
          ]
        },
        "liveWriteMd.slidesFrame": {
          "description": "在页面内容区四周的留白里加一点克制的装饰：内嵌发丝线或四角标记。只影响 PPT 渲染，不改文档。工具栏「边框」按钮也能直接切换。",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "rule",
            "corners"
          ],
          "enumDescriptions": [
            "无",
            "细线框",
            "四角标记"
          ]
        },
        "liveWriteMd.slidesHeadingLevel": {
          "description": "按哪一级标题开启新页。选自动时：同时有 H1/H2 就把 H1 当章节页、H2 当内容页；只有一级标题时直接用那一级。",
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "1",
            "2",
            "3"
          ],
          "enumDescriptions": [
            "自动",
            "一级标题（H1）",
            "二级标题（H2）",
            "三级标题（H3）"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "esbuild src/extension/index.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --minify",
    "build:webview": "node scripts/build-webview.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "watch:extension": "esbuild src/extension/index.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "watch:webview": "node scripts/build-webview.mjs --watch",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "typecheck": "tsc --noEmit",
    "package:vsix": "node ./scripts/package-vsix.mjs",
    "test:probe": "node scripts/run-probes.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vitest/coverage-v8": "^4.0.18",
    "@vscode/test-electron": "^2.x",
    "esbuild": "^0.19.x",
    "eslint": "^8.x",
    "happy-dom": "^20.5.0",
    "mocha": "^11.7.5",
    "prettier": "^3.x",
    "typescript": "^5.x",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "katex": "^0.16.28",
    "marked": "^16.2.0",
    "mermaid": "^11.12.2"
  }
}
