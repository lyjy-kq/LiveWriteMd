                        "auto",
                        "default",
                        "dark"
                    ],
                    "enumDescriptions": [
                        "自动（跟随编辑器）",
                        "默认（经典浅色）",
                        "深色"
                    ]
                },
                "mindmapDefaultExpandLevel": {
                    "description": "打开导图时默认展开到第几层，0 = 只显示根节点。",
                    "type": "number",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 6,
                    "multipleOf": 1
                },
                "mindmapPerformanceMode": {
                    "description": "画布可视区域外的节点不渲染，大文档更流畅。",
                    "type": "boolean",
                    "default": true
                },
                "mindmapNodeMaxWidth": {
                    "description": "文本节点一行最多排几列（1 列 = 1 个中文字宽），超出换行；与「节点最大行数」共同决定截断点。",
                    "type": "number",
                    "default": 20,
                    "minimum": 5,
                    "maximum": 60,
                    "multipleOf": 1
                },
                "mindmapNodeMaxLines": {
                    "description": "文本节点最多显示几行，超出部分截断加省略号；点击已选中的节点可先展开到最大行数，再点进入编辑。",
                    "type": "number",
                    "default": 3,
                    "minimum": 1,
                    "maximum": 10,
                    "multipleOf": 1
                },
                "mindmapCodeMinWidth": {
                    "description": "代码块节点的最小宽度（1 列 = 1 个等宽字符宽），避免短代码的节点过窄；0 = 不设最小宽度。",
                    "type": "number",
                    "default": 10,
                    "minimum": 0,
                    "maximum": 60,
                    "multipleOf": 1
                },
                "mindmapLiteZoom": {
                    "description": "缩小到该比例以下时，节点不再渲染行内格式、代码高亮、表格 / 公式 / mermaid 图，只保留 Markdown 源码排版，拖动更流畅。",
                    "type": "number",
                    "default": 70,
                    "minimum": 10,
                    "maximum": 100,
                    "multipleOf": 5
                },
                "mindmapPlainZoom": {
                    "description": "缩小到该比例以下时，节点只用纯文本占位（媒体节点显示摘要），不创建任何 CodeMirror 实例；建议不高于「降级渲染缩放」。",
                    "type": "number",
                    "default": 40,
                    "minimum": 5,
                    "maximum": 100,
                    "multipleOf": 5
                },
                "theme": {
                    "description": "设为自动时跟随 VS Code 当前主题。",
                    "type": "string",
                    "default": "auto",
                    "enum": [
                        "auto",
                        "dark",
                        "light"
                    ],
                    "enumDescriptions": [
                        "自动（跟随 VS Code）",
                        "深色",
                        "浅色"
                    ]
                },
