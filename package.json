{
    "name": "lyjy-obsidianlike-md",
    "displayName": "Lyjy ObsidianLike MD for VS Code",
    "description": "WYSIWYG Markdown editor for VS Code with Obsidian-style live preview. Tables, Mermaid diagrams, KaTeX math, code block syntax highlighting, and full IME support.",
    "version": "1.0.7",
    "publisher": "lyjy",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/lyjy-kq/lyjy-obsidianlike-md-forvscode"
    },
    "bugs": {
        "url": "https://github.com/lyjy-kq/lyjy-obsidianlike-md-forvscode/issues"
    },
    "homepage": "https://github.com/lyjy-kq/lyjy-obsidianlike-md-forvscode#readme",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "markdown",
        "markdown editor",
        "wysiwyg",
        "obsidian",
        "live preview",
        "mermaid",
        "katex",
        "table",
        "code block",
        "math"
    ],
    "galleryBanner": {
        "color": "#272b33",
        "theme": "dark"
    },
    "markdown": "github",
    "qna": "marketplace",
    "activationEvents": [
        "onCustomEditor:flowMd.editor",
        "onCommand:flowMd.exportAsHtml",
        "onCommand:flowMd.exportAsPdf",
        "onCommand:flowMd.toggleOutline"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "configurationDefaults": {
            "workbench.editorAssociations": {
                "{git,gist}:/**/*.md": "default"
            }
        },
        "customEditors": [
            {
                "viewType": "flowMd.editor",
                "displayName": "FlowMD Editor",
                "selector": [
                    {
                        "filenamePattern": "*.md",
                        "scheme": "file"
                    },
                    {
                        "filenamePattern": "*.md",
                        "scheme": "untitled"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "flowMd.openWith",
                "title": "Open with FlowMD",
                "category": "FlowMD"
            },
            {
                "command": "flowMd.enterViewerMode",
                "title": "FlowMD: Viewer Mode",
                "category": "FlowMD",
                "icon": "$(book)"
            },
            {
                "command": "flowMd.enterSourceMode",
                "title": "FlowMD: Source Mode",
                "category": "FlowMD",
                "icon": "$(code)"
            },
            {
                "command": "flowMd.enterLiveMode",
                "title": "FlowMD: Live Preview Mode",
                "category": "FlowMD",
                "icon": "$(edit)"
            },
            {
                "command": "flowMd.exportAsHtml",
                "title": "Export as HTML",
                "category": "FlowMD"
            },
            {
                "command": "flowMd.exportAsPdf",
                "title": "Export as PDF",
                "category": "FlowMD"
            },
            {
                "command": "flowMd.toggleOutline",
                "title": "FlowMD: 显示/隐藏大纲",
                "category": "FlowMD",
                "icon": "$(list-unordered)"
            },
            {
                "command": "flowMd.openSettings",
                "title": "设置",
                "category": "FlowMD",
                "icon": "$(settings-gear)"
            },
            {
                "command": "flowMd.insertImage",
                "title": "Insert Image",
                "category": "FlowMD",
                "icon": "$(file-media)"
            },
            {
                "command": "flowMd.insertImageFromExplorer",
                "title": "Insert into FlowMD",
                "category": "FlowMD",
                "icon": "$(file-media)"
            }
        ],
        "keybindings": [
            {
                "command": "flowMd.noop",
                "key": "ctrl+z",
                "mac": "cmd+z",
                "when": "activeCustomEditorId == flowMd.editor"
            },
            {
                "command": "flowMd.noop",
                "key": "ctrl+shift+z",
                "mac": "cmd+shift+z",
                "when": "activeCustomEditorId == flowMd.editor"
            },
            {
                "command": "flowMd.noop",
                "key": "ctrl+y",
                "mac": "cmd+y",
                "when": "activeCustomEditorId == flowMd.editor"
            },
            {
                "command": "flowMd.insertImage",
                "key": "ctrl+shift+i",
                "mac": "cmd+shift+i",
                "when": "activeCustomEditorId == flowMd.editor"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "flowMd.openWith",
                    "when": "resourceExtname == .md",
                    "group": "navigation"
                },
                {
                    "command": "flowMd.insertImageFromExplorer",
                    "when": "activeCustomEditorId == flowMd.editor && resourceExtname =~ /^\\.(png|jpg|jpeg|gif|webp|svg|bmp)$/i",
                    "group": "navigation@2"
                },
                {
                    "command": "flowMd.exportAsHtml",
                    "when": "resourceExtname == .md",
                    "group": "1_modification"
                },
                {
                    "command": "flowMd.exportAsPdf",
                    "when": "resourceExtname == .md",
                    "group": "1_modification"
                }
            ],
            "editor/title": [
                {
                    "command": "flowMd.toggleOutline",
                    "when": "activeCustomEditorId == flowMd.editor",
                    "group": "navigation@9"
                },
                {
                    "command": "flowMd.openSettings",
                    "when": "activeCustomEditorId == flowMd.editor",
                    "group": "navigation@10"
                }
            ]
        },
        "configuration": {
            "title": "FlowMD",
            "properties": {
                "flowMd.largeFileWarningThreshold": {
                    "type": "number",
                    "default": 1048576,
                    "minimum": 0,
                    "description": "Large file warning threshold in bytes. Set to 0 to disable."
                },
                "flowMd.syncDebounceMs": {
                    "type": "number",
                    "default": 300,
                    "minimum": 50,
                    "maximum": 2000,
                    "description": "Sync debounce time in milliseconds"
                },
                "flowMd.enableDebugLog": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable verbose debug logging. Logs appear in the Output panel (View > Output > FlowMD)."
                },
                "flowMd.lineNumbers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show line numbers"
                },
                "flowMd.wordWrap": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable word wrap for long lines"
                },
                "flowMd.readableLineLength": {
                    "type": "number",
                    "default": 900,
                    "minimum": 0,
                    "description": "Max content width in pixels. Set to 0 for unlimited. Default: 900"
                },
                "flowMd.fontScale": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0.5,
                    "maximum": 2,
                    "description": "Editor body font size scale. Ctrl+wheel changes this value and saves it automatically.",
                    "markdownDescription": "编辑器正文的字体大小缩放倍率。按 `Ctrl+滚轮` 调整后会自动保存。"
                },
                "flowMd.theme": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "dark",
                        "light"
                    ],
                    "default": "auto",
                    "description": "Theme setting (auto: follow VS Code theme)"
                },
                "flowMd.imageSaveFolder": {
                    "type": "string",
                    "default": "assets",
                    "description": "Folder name for saved images (relative to .md file). Default: assets"
                },
                "flowMd.pdfBrowserPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Edge/Chrome executable used for PDF export. Leave empty to auto-detect.",
                    "markdownDescription": "导出 PDF 所用的 Edge/Chrome 可执行文件路径。留空则自动探测。"
                },
                "flowMd.defaultMode": {
                    "type": "string",
                    "enum": [
                        "live",
                        "source",
                        "viewer"
                    ],
                    "default": "live",
                    "description": "Default editing mode when opening files",
                    "enumDescriptions": [
                        "Live Preview - Edit with real-time rendering",
                        "Source - Raw Markdown source only",
                        "Viewer - Read-only rendered view"
                    ]
                },
                "flowMd.modeSwitcher": {
                    "type": "string",
                    "enum": [
                        "cycle",
                        "buttons"
                    ],
                    "default": "cycle",
                    "description": "Mode switcher button style in the editor title bar",
                    "enumDescriptions": [
                        "Cycle - Single button that cycles Live → Viewer → Source",
                        "Buttons - Show direct-jump buttons for the other two modes"
                    ]
                },
                "flowMd.rememberLastMode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Remember the editing mode used per file instead of always using Default mode."
                },
                "flowMd.smartUrlPaste": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically wrap a pasted bare URL as a Markdown link."
                },
                "flowMd.highlightActiveLine": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight the line that contains the cursor."
                },
                "flowMd.highlightWhitespace": {
                    "type": "boolean",
                    "default": false,
                    "description": "Render spaces and tabs with subtle markers."
                },
                "flowMd.h1Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 1 color. Empty = auto (follow the theme)."
                },
                "flowMd.h2Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 2 color. Empty = auto (follow the theme)."
                },
                "flowMd.h3Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 3 color. Empty = auto (follow the theme)."
                },
                "flowMd.h4Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 4 color. Empty = auto (follow the theme)."
                },
                "flowMd.h5Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 5 color. Empty = auto (follow the theme)."
                },
                "flowMd.h6Color": {
                    "type": "string",
                    "default": "",
                    "description": "Heading 6 color. Empty = auto (follow the theme)."
                },
                "flowMd.h1Size": {
                    "type": "number",
                    "default": 1.2,
                    "minimum": 0.9,
                    "maximum": 2,
                    "multipleOf": 0.01,
                    "description": "Heading 1 font size relative to body text."
                },
                "flowMd.boldColor": {
                    "type": "string",
                    "default": "",
                    "description": "Bold text color. Empty = auto (follow the theme)."
                },
                "flowMd.italicColor": {
                    "type": "string",
                    "default": "",
                    "description": "Italic text color. Empty = auto (follow the theme)."
                },
                "flowMd.italicSlant": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use a real slanted italic glyph instead of color-only emphasis."
                },
                "flowMd.strikethroughColor": {
                    "type": "string",
                    "default": "",
                    "description": "Strikethrough color. Empty = auto (follow the theme)."
                },
                "flowMd.inlineCodeColor": {
                    "type": "string",
                    "default": "",
                    "description": "Inline code text color. Empty = auto (follow the theme)."
                },
                "flowMd.inlineCodeBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Inline code background color. Empty = auto (follow the theme)."
                },
                "flowMd.inlineCodeScale": {
                    "type": "number",
                    "default": 0.95,
                    "minimum": 0.8,
                    "maximum": 1.05,
                    "multipleOf": 0.01,
                    "description": "Inline code font size relative to body text."
                },
                "flowMd.codeblockBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Code block background color. Empty = follow VS Code theme."
                },
                "flowMd.codeblockEdge": {
                    "type": "string",
                    "default": "",
                    "description": "Code block edge color. Empty = follow VS Code theme."
                },
                "flowMd.linkColor": {
                    "type": "string",
                    "default": "",
                    "description": "Link color. Empty = auto (follow the theme)."
                },
                "flowMd.quoteBorderColor": {
                    "type": "string",
                    "default": "",
                    "description": "Blockquote left border color. Empty = auto (follow the theme)."
                },
                "flowMd.quoteTextColor": {
                    "type": "string",
                    "default": "",
                    "description": "Blockquote text color. Empty = auto (follow the theme)."
                },
                "flowMd.hrColor": {
                    "type": "string",
                    "default": "",
                    "description": "Horizontal rule color. Empty = auto (follow the theme)."
                },
                "flowMd.tableBorderColor": {
                    "type": "string",
                    "default": "",
                    "description": "Table border color. Empty = auto (follow the theme)."
                },
                "flowMd.tableHeaderBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Table header background color. Empty = auto (follow the theme)."
                },
                "flowMd.tableStripeBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Background for striped (even) table rows. Empty = no stripes."
                },
                "flowMd.tableSelectedBackground": {
                    "type": "string",
                    "default": "",
                    "description": "Selected table cell highlight color. Empty = auto (follow the theme)."
                },
                "flowMd.bulletColor": {
                    "type": "string",
                    "default": "",
                    "description": "List bullet color. Empty = auto (follow the theme)."
                },
                "flowMd.checkboxAccent": {
                    "type": "string",
                    "default": "",
                    "description": "Checkbox accent color. Empty = auto (follow the theme)."
                },
                "flowMd.outlineAutoOpen": {
                    "type": "boolean",
                    "default": false,
                    "description": "Expand the outline automatically when a file opens."
                },
                "flowMd.outlineWidth": {
                    "type": "number",
                    "default": 280,
                    "minimum": 220,
                    "maximum": 480,
                    "multipleOf": 4,
                    "description": "Default outline panel width in pixels."
                },
                "flowMd.outlineGuides": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show indentation guides in the outline."
                },
                "flowMd.mediaWidth": {
                    "type": "number",
                    "default": 75,
                    "minimum": 20,
                    "maximum": 100,
                    "description": "Default media width as a percentage of body width."
                },
                "flowMd.mediaCenter": {
                    "type": "boolean",
                    "default": true,
                    "description": "Center media that occupies its own line."
                },
                "flowMd.dragThreshold": {
                    "type": "number",
                    "default": 4,
                    "minimum": 2,
                    "maximum": 15,
                    "description": "Mouse movement in pixels required to count as a drag-select."
                },
                "flowMd.doubleClickPin": {
                    "type": "boolean",
                    "default": true,
                    "description": "Double-click to pin the source view of a line."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "npm run build:extension && npm run build:webview",
        "build:extension": "esbuild src/extension/index.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --minify",
        "build:webview": "node -e \"require('fs').rmSync('dist/chunks',{recursive:true,force:true})\" && esbuild src/webview/main.ts --bundle --outdir=dist --entry-names=webview --chunk-names=chunks/[name]-[hash] --format=esm --splitting --platform=browser --sourcemap --minify --pure:console.debug --loader:.css=text",
        "watch": "node esbuild.config.mjs --watch",
        "watch:extension": "esbuild src/extension/index.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
        "watch:webview": "esbuild src/webview/main.ts --bundle --outdir=dist --entry-names=webview --chunk-names=chunks/[name]-[hash] --format=esm --splitting --platform=browser --sourcemap --watch --pure:console.debug --loader:.css=text",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "typecheck": "tsc --noEmit",
        "package:vsix": "node ./scripts/package-vsix.mjs"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.x",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^6.x",
        "@typescript-eslint/parser": "^6.x",
        "@vitest/coverage-v8": "^4.0.18",
        "@vscode/test-electron": "^2.x",
        "esbuild": "^0.19.x",
        "eslint": "^8.x",
        "happy-dom": "^20.5.0",
        "mocha": "^11.7.5",
        "prettier": "^3.x",
        "typescript": "^5.x",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@codemirror/commands": "^6.10.1",
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-go": "^6.0.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-java": "^6.0.2",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/lang-php": "^6.0.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.1",
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/legacy-modes": "^6.5.4",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.5.4",
        "@codemirror/view": "^6.39.12",
        "@lezer/common": "^1.5.1",
        "@lezer/highlight": "^1.2.3",
        "katex": "^0.16.28",
        "marked": "^16.2.0",
        "mermaid": "^11.12.2"
    }
}
