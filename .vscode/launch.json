{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch FlowMD Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--disable-extensions",
                "--user-data-dir=${workspaceFolder}/.vscode/.flowmd-dev-userdata",
                "--extensions-dir=${workspaceFolder}/.vscode/.flowmd-dev-extensions",
                // 启动就在开发宿主里打开这个文件，省得每次 F5 完还要手动去点开验收。
                // 等价于 dev.ps1 -Mode debug 的 -File 参数（build 模式不拉窗口，所以那个参数
                // 挂在这边没意义，真正开文件的是这一行）。想换验收对象就改这个路径，
                // 路径里有中文和全角括号都没事，用正斜杠是为了不用写 // 转义。
                "C:/Users/pc/Desktop/code/lyjy-obsidianlike-md-forvscode/test"
            ],
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            // 按 F5 前先跑 scripts/dev.ps1 -Mode build（任务定义见 .vscode/tasks.json）。
            // 原来写的 "pnpm: build" 在本机跑不起来：pnpm 没授权 esbuild 的构建脚本，
            // 会直接 ERR_PNPM_IGNORED_BUILDS；脚本里默认用的 npm 是能用的。
            "preLaunchTask": "FlowMD: build (dev.ps1)",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "trace": false
        },
        {
            "name": "Attach to Running Extension Host",
            "type": "extensionHost",
            "request": "attach",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "trace": false
        }
    ]
}
