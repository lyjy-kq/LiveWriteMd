{
    "version": "0.2.0",
    "configurations": [
        
        {
            // F5 默认项：直接拉起 Chrome 打开编辑器调试页
            // （test/repro/browser.html，由 scripts/dev-browser.mjs 提供服务），
            // 并自动打开 DevTools，用浏览器方式反馈渲染问题。
            // 换文档：浏览器地址栏 URL 加 ?doc=test/xxx.md；
            // 换浅色：?theme=light。
            "name": "Debug Webview in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:8740/test/repro/browser.html",
            "webRoot": "${workspaceFolder}",
            // 独立 profile：一是不污染你日常用的 Chrome，
            // 二是 Chrome 已有普通实例在跑时，新参数（自动开 DevTools）
            // 对挂到旧实例上的标签不生效，必须是独立实例
            "userDataDir": "${workspaceFolder}/.vscode/.chrome-dev-profile",
            // 启动即自动打开 DevTools，不用再按 F12
            "runtimeArgs": [
                "--auto-open-devtools-for-tabs"
            ],
            "sourceMaps": true,
            // sourcemap 只认本仓库的（含 src TS 源码），排除 node_modules
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            // 前置：watch 构建 + 静态服务器（后台任务，见 tasks.json）
            "preLaunchTask": "LiveWriteMD: browser dev server"
        },
        {
            // 扩展调试的 F5 配置。
            //
            // 为什么不用内置的 extensionHost launch（原来的写法）：
            // VS Code 1.138 里，js-debug 自动 attach 扩展宿主的那条路径会随机把
            // 扩展宿主进程打崩（Windows 退出码 134，SIGABRT），表现就是 F5 拉起的
            // 窗口闪退几次才稳定。上游 issue：microsoft/vscode#336233。
            // 该 issue 里验证稳定的两条路：Ctrl+F5（不挂调试器）和
            // 「CLI 起宿主 + node attach」。这里用的是后者，保留断点能力。
            //
            // F5 流程：
            //   1. preLaunchTask 跑 dev.ps1 -Mode debug：构建 dist，用 code CLI
            //      在当前 VS Code 实例里打开开发宿主窗口（复用默认 profile，
            //      主题/字号等用户设置和日常窗口一致），并等它的 Node inspector
            //      端口开始监听后才退出；
            //   2. 本配置再 node attach 到 127.0.0.1:9229。
            // 任务退出是「端口就绪」的信号，所以 attach 不会连早了连空。
            "name": "Launch LiveWriteMD Extension",
            "type": "node",
            "request": "attach",
            // 明确写 IPv4：1.139 有过 attach 走 localhost 解析到 ::1、
            // 而 inspector 只监听 127.0.0.1 导致连不上的问题。
            "address": "127.0.0.1",
            "port": 9229,
            // 只 attach 一次。宿主 reload 后重新按 F5 即可（会重新跑前置任务）。
            "restart": false,
            // 连接超时（毫秒）。前置任务已经把端口等出来了，这里只是兜底。
            "timeout": 60000,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "preLaunchTask": "LiveWriteMD: dev host (dev.ps1)",
            "trace": false
        },
        {
            "name": "Attach to Running Extension Host",
            "type": "extensionHost",
            "request": "attach",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "trace": false
        }
    ]
}
