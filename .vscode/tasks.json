{
    "version": "2.0.0",
    "tasks": [
        {
            // F5 浏览器调试（.vscode/launch.json 的 chrome 配置）的前置任务：
            // 跑 scripts/dev-browser.mjs —— esbuild watch 打包 test/repro/browser.ts
            // + 本地静态服务器，是个常驻后台任务。
            // 任务输出 "dev-server ready" 时视为就绪，之后 Chrome 才会被拉起。
            "label": "LiveWriteMD: browser dev server",
            "type": "shell",
            "command": "node",
            "args": [
                "${workspaceFolder}/scripts/dev-browser.mjs"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                // 不扫描构建报错（esbuild 的错误直接在终端看），
                // 正则写成永不匹配；这个 matcher 只为提供 background 就绪信号
                "pattern": {
                    "regexp": "^(?!x)x$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    // 必须同时给开始/结束模式，缺 beginsPattern VS Code
                    // 会直接报「问题匹配程序必须定义监视的开始模式和结束模式」
                    "beginsPattern": "dev-server starting",
                    "endsPattern": "dev-server ready"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            // 扩展调试 F5 的前置任务（.vscode/launch.json 里 node attach 配置）。
            //
            // 走 scripts/dev.ps1 的 debug 模式：构建 dist → 用 code CLI 在当前 VS Code
            // 实例里打开开发宿主窗口（复用默认 profile，主题/字号和日常窗口一致）
            // → 轮询等 Node inspector 端口（9229）真正监听 → 退出。
            // 任务退出后，launch.json 的 node attach 才去连 9229，所以不会连空。
            //
            // 为什么不用内置的 extensionHost launch：js-debug 自动 attach 扩展宿主
            // 的路径在 VS Code 1.138 上会随机把宿主打崩（退出码 134），
            // 详见 launch.json 里的注释和 microsoft/vscode#336233。
            "label": "LiveWriteMD: dev host (dev.ps1)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev.ps1",
                "-Mode",
                "debug",
                // 启动就在开发宿主里打开这个目录验收（原来写在 launch.json args 里，
                // 现在窗口由 dev.ps1 用 CLI 拉起，所以挪到这里）。想换验收对象就改这个路径。
                "-File",
                "C:/Users/pc/Desktop/code/work/edu-科研"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            // 空数组 = 不扫描输出里的报错（同下面的 build 任务），避免 F5 卡在弹窗上
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // 只构建 dist/ 的任务（不起窗口、不出包）。
            // 注意：扩展调试的 F5 现在用的是上面的 dev host 任务（里面已经先构建了），
            // 这个任务留给「手动构建」或其它需要只构建的场景。
            // 这里刻意不直接写 npm/esbuild 命令，把构建逻辑收在脚本一处，
            // 避免以后脚本改了、任务里还留着一份对不上的旧命令。
            "label": "LiveWriteMD: build (dev.ps1)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev.ps1",
                "-Mode",
                "build"
            ],
            // 和 tasks 同目录的 scripts/dev.ps1 自己会切到仓库根目录（看 $PSScriptRoot），
            // 但这里还是显式指定，免得 VS Code 用了别的 cwd 让人犯嘀咕。
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            // 空数组 = 不去扫描输出里的报错。不清空的话 VS Code 会反问
            // 「要扫描任务输出吗」，F5 会卡在一个多余的弹窗上。
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "pnpm: build",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "run",
                "build"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "pnpm: watch",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "run",
                "watch"
            ],
            "isBackground": true,
            "group": "build",
            "problemMatcher": []
        }
    ]
}
